# Public HTTPS host and exact Web Origin (no trailing slash).
MATTERDESK_PUBLIC_HOST=matter.linanw.me
# NAS nginx/DSM reverse proxy target. Leave the bind address on loopback.
MATTERDESK_PROXY_PORT=18081
# Keep controller API on loopback; change only if 5580 is already in use.
MATTERDESK_CONTROLLER_PORT=5580
# Optional NAS network interface for Matter multicast (e.g. eth0, ovs_eth0, bond0).
MATTER_INTERFACE=
# Must be built before starting gateway: npm --prefix web run build (from repo root).
MATTERDESK_WEB_DIST=../web/dist
# Use the generated bcrypt file, never upload it to source control.
MATTERDESK_USERS_FILE=./secrets/users.caddy
